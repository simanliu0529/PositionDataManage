# Copy to .env if needed. Local PowerShell sessions require setting $env: variables.
CHECKIN_DATA=data
CHECKIN_NODE_0=http://127.0.0.1:8100
CHECKIN_NODE_1=http://127.0.0.1:8101
CHECKIN_MAX_UPLOAD_BYTES=1073741824
CHECKIN_UPLOAD_SLOTS=2
CHECKIN_MAX_LINE_BYTES=65536
# Set to 1 behind HTTPS. Keep 0 for local HTTP development.
CHECKIN_SECURE_COOKIE=0
# Optional authorized offline XYZ tiles:
# CHECKIN_TILE_URL=/tiles/{z}/{x}/{y}.png
# CHECKIN_TILE_ROOT=data/tiles
# CHECKIN_MAP_NAME=Offline map
# CHECKIN_MAP_ATTRIBUTION=Your licensed data source
# CHECKIN_MAP_ATTRIBUTION_URL=https://your-source.example/license
